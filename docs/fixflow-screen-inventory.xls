<?xml version="1.0"?><?mso-application progid="Excel.Sheet"?><Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"><Styles><Style ss:ID="Header"><Font ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#17365D" ss:Pattern="Solid"/><Alignment ss:WrapText="1"/></Style><Style ss:ID="Cell"><Alignment ss:Vertical="Top" ss:WrapText="1"/></Style></Styles><Worksheet ss:Name="Danh sach giao dien"><Table ss:ExpandedColumnCount="5" ss:ExpandedRowCount="21"><Column ss:Width="125"/><Column ss:Width="180"/><Column ss:Width="360"/><Column ss:Width="270"/><Column ss:Width="400"/><Row><Cell ss:StyleID="Header"><Data ss:Type="String">Vai trò người dùng</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Tên giao diện</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Chức năng chính</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Tên tệp tin giao diện</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Vai trò / mục đích giao diện</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Dùng chung</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Đăng nhập</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Đăng nhập và xác thực tài khoản</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/login.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Cổng vào hệ thống; chuyển người dùng đến dashboard sau khi đăng nhập</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Dùng chung</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Đăng ký</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Tạo tài khoản người dùng mới</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/register.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Tiếp nhận thông tin tài khoản và vai trò ban đầu</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Dùng chung</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Khôi phục mật khẩu</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Gửi yêu cầu khôi phục mật khẩu</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/forgot-password.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Hỗ trợ người dùng lấy lại quyền truy cập</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Dùng chung</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Dashboard</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Tóm tắt ticket, SLA và lối tắt nghiệp vụ</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/index.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Màn hình tổng quan sau đăng nhập</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Dùng chung</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Thông báo</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Xem thông báo ticket và SLA</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/notifications.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Trung tâm nhắc việc và cập nhật trạng thái</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Dùng chung</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Hồ sơ cá nhân</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Xem và chỉnh sửa thông tin cá nhân</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/profile.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản lý thông tin tài khoản hiện tại</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Dùng chung</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Không có quyền</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Thông báo truy cập bị từ chối</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/403.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Phản hồi lỗi phân quyền và quay về dashboard</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Dùng chung</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Không tìm thấy trang</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Thông báo đường dẫn không tồn tại</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/404.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Phản hồi lỗi đường dẫn và điều hướng về trang chủ</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Người yêu cầu</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Tạo yêu cầu bảo trì</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Chọn thiết bị, tự điền phòng, mô tả lỗi, mức độ, ảnh, AI phân loại và gửi ticket</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/requester-ticket-create.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Tạo ticket mới; có validation và lưu dữ liệu</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Người yêu cầu</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Yêu cầu của tôi</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Xem, tìm kiếm và lọc các ticket đã tạo</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/requester-my-tickets.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Theo dõi danh sách ticket cá nhân theo trạng thái/SLA</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Người yêu cầu</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Chi tiết ticket</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Xem timeline, trạng thái, SLA và gửi phản hồi</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/requester-ticket-detail.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Theo dõi một ticket từ lúc tạo đến hoàn tất</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Kỹ thuật viên</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Hàng đợi công việc</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Xem ticket, tìm kiếm/lọc, ưu tiên và nhận việc</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/technician-work-queue.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Danh sách công việc cần kỹ thuật viên xử lý</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Kỹ thuật viên</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Chi tiết sửa chữa</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Cập nhật trạng thái, checklist, nguyên nhân, vật tư và ghi chú</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/technician-repair-detail.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Không gian xử lý một ticket tại hiện trường</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Kỹ thuật viên</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Lịch sử sửa chữa</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Tra cứu các lần sửa chữa theo thiết bị/nguyên nhân</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/technician-repair-history.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Lưu lại và đối chiếu lịch sử bảo trì</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản lý bảo trì</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Bảng điều phối</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Xem ticket chưa gán và phân công kỹ thuật viên</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/manager-dispatch-board.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Màn hình điều phối nhân lực và ticket</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản lý bảo trì</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Giám sát SLA</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Xem KPI, cảnh báo sắp hạn/quá hạn và lọc ticket</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/manager-sla-monitor.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Theo dõi hiệu suất và rủi ro vi phạm SLA</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản lý bảo trì</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Phân tích lỗi lặp lại</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI tóm tắt lỗi lặp, độ chắc chắn và đề xuất bảo trì</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/manager-failure-insights.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Hỗ trợ quyết định bảo trì dự phòng</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản trị viên</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản lý thiết bị</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Thêm, xem, sửa, tìm kiếm và lưu trữ thiết bị</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/admin-asset-management.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản lý danh mục tài sản và vị trí thiết bị</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản trị viên</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản lý nhóm lỗi</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Thêm, sửa và xem các nhóm lỗi/taxonomy</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">pages/admin-issue-category-management.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Chuẩn hóa loại lỗi để phân loại ticket</Data></Cell></Row><Row><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản trị viên</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">Quản lý người dùng</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="St